{
  "name": "fullcomercy",
  "version": "0.1.0",
  "private": true,
  "description": "FullComercy — ERP SaaS modular e multi-tenant (API + Web)",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build -w apps/api && npm run build -w apps/web",
    "typecheck": "npm run typecheck -w apps/api && npm run typecheck -w apps/web",
    "test": "npm test -w apps/api",
    "test:e2e": "npm run test:e2e -w apps/api",
    "prisma:migrate": "npm run prisma:migrate -w apps/api",
    "prisma:deploy": "npm run prisma:deploy -w apps/api",
    "db:rls": "npm run db:rls -w apps/api",
    "db:seed": "npm run db:seed -w apps/api",
    "docs:api": "npm run docs:api -w apps/api",
    "test:ui": "npm run test:ui -w apps/web"
  }
}
