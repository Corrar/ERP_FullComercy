{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "rootDir": ".",
    "outDir": "./dist",
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": false,
    "skipLibCheck": true,
    "sourceMap": true
  },
  "ts-node": { "esm": false, "transpileOnly": true },
  "include": ["src/**/*", "prisma/seed.ts", "test/**/*.ts"]
}
