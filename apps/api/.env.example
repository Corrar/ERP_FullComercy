# ─────────────────────────────────────────────────────────────
# FullComercy — Backend · variáveis de ambiente (EXEMPLO)
# Copie para `.env` e preencha. NUNCA comite o `.env` real.
# ─────────────────────────────────────────────────────────────

# ── Obrigatórias ──
# Papel do TENANT (comum, sujeito ao RLS): é o que o código de negócio usa.
DATABASE_URL=postgresql://app_rw:password@host:5432/fullcomercy?schema=public
JWT_SECRET=                      # >= 32 caracteres aleatórios

# ── Plataforma / RLS ──
# Papel com BYPASSRLS (login, onboarding, jobs, migrations). OBRIGATÓRIA em produção com RLS.
DATABASE_ADMIN_URL=postgresql://fc_platform:password@host:5432/fullcomercy?schema=public
TENANT_RLS=1                     # 0 só se o banco NÃO tiver RLS
APP_ENCRYPTION_KEY=              # cifra de segredos em JSON (token da catraca); >= 16 chars

# ── Opcionais (têm default) ──
NODE_ENV=development
PORT=3000
TRUST_PROXY_HOPS=1               # saltos de proxy até o Express; 4 em Vercel → Cloudflare → Render (ver config/env.ts)
RATE_LIMIT_PER_MIN=600           # teto global por IP/minuto (o Playwright sobe a API com 20000: a suíte sai de um IP só)
JWT_ACCESS_TTL=15m               # vida do access token
JWT_REFRESH_TTL_DAYS=30          # vida do refresh token
CORS_ORIGINS=                    # lista separada por vírgula; localhost sempre liberado
TENANT_CACHE_TTL_MS=15000        # cache de "tenant + módulos ativos"
JOBS_ENABLED=1                   # 0 desliga os jobs em processo (instância só-API)

# ── Plataforma (quem opera o SaaS) ──
PLATFORM_API_KEY=                # >= 32 chars; sem ela, /platform/* não existe

# ── Seed ──
SEED_ADMIN_PASSWORD=             # senha do admin dos tenants de demonstração

# ── E-mail transacional (sem SMTP_HOST, provedor console: só loga o link) ──
APP_URL=http://localhost:5173    # URL do front para links de e-mail
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=FullComercy <no-reply@fullcomercy.local>

# ── Auditoria HTTP genérica de mutações (opt-in) ──
AUDIT_HTTP=0

# ── Loja de módulos / assinatura do SaaS ──
ACCOUNT_TOKEN_TTL=12h            # vida do token da conta do comprador
GOOGLE_CLIENT_ID=                # OAuth client ID (Google Identity Services); vazio = sem "Entrar com Google"
GOOGLE_AUTH_MOCK=0               # 1 = aceita Google simulado (só dev/teste; recusado em produção)
BILLING_PROVIDER=mock            # mock | stripe; mock é recusado em produção
STRIPE_SECRET_KEY=               # sk_test_… (homologação) / sk_live_… (produção) — só no servidor
STRIPE_PUBLISHABLE_KEY=          # pk_test_… / pk_live_… — vai para o navegador pelo catálogo
STRIPE_WEBHOOK_SECRET=           # whsec_… do endpoint /public/billing/webhooks/stripe
TURNSTILE_SITE_KEY=              # Cloudflare Turnstile (obrigatório em produção)
TURNSTILE_SECRET_KEY=
BILLING_MOCK_WEBHOOK_TOKEN=      # >= 16 chars; header x-billing-token do webhook mock
BILLING_TRIAL_DAYS=7             # teste grátis da primeira compra
BILLING_GRACE_DAYS=10            # atraso tolerado antes de suspender a empresa
