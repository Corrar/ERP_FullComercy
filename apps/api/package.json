{
  "name": "@fullcomercy/api",
  "version": "0.1.0",
  "private": true,
  "description": "FullComercy — ERP SaaS modular e multi-tenant (Node.js + TypeScript + Express 5 + Prisma)",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "ts-node src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "node scripts/prisma-admin.js migrate dev",
    "prisma:deploy": "node scripts/prisma-admin.js migrate deploy",
    "prisma:studio": "node scripts/prisma-admin.js studio",
    "db:seed": "ts-node prisma/seed.ts",
    "test": "TS_NODE_TRANSPILE_ONLY=1 node -r ts-node/register --test 'test/*.test.ts'",
    "smoke:boot": "ts-node -T -e \"require('./src/app').buildApp(); console.log('boot ok')\"",
    "test:e2e": "E2E=1 TS_NODE_TRANSPILE_ONLY=1 node -r ts-node/register --test-concurrency=1 --test 'test/e2e/*.test.ts'",
    "test:all": "npm test && npm run test:e2e",
    "db:rls": "node scripts/apply-rls.js",
    "docs:api": "ts-node -T scripts/gerar-api-md.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "bcryptjs": "^3.0.3",
    "bwip-js": "^4.11.4",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.1.2",
    "pdfkit": "^0.20.2",
    "socket.io": "^4.8.4",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.11.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "prisma": "^6.16.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
