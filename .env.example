# ─────────────────────────────────────────────────────────────
# FullComercy — Backend · variáveis de ambiente (EXEMPLO)
# Copie para `.env` e preencha. NUNCA comite o `.env` real.
# ─────────────────────────────────────────────────────────────

# ── Obrigatórias ──
DATABASE_URL=postgresql://user:password@host:5432/fullcomercy?schema=public
JWT_SECRET=                      # >= 32 caracteres aleatórios

# ── Opcionais (têm default) ──
NODE_ENV=development
PORT=3000
JWT_ACCESS_TTL=15m               # vida do access token
JWT_REFRESH_TTL_DAYS=30          # vida do refresh token
CORS_ORIGINS=                    # lista separada por vírgula; localhost sempre liberado
TENANT_CACHE_TTL_MS=15000        # cache de "tenant + módulos ativos"
JOBS_ENABLED=1                   # 0 desliga os jobs em processo (instância só-API)

# ── Plataforma (quem opera o SaaS) ──
PLATFORM_API_KEY=                # >= 32 chars; sem ela, /platform/* não existe

# ── Seed ──
SEED_ADMIN_PASSWORD=             # senha do admin dos tenants de demonstração
